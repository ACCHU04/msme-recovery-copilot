# Copy to .env.local (never commit .env.local). NEXT_PUBLIC_* values are built into the
# page bundle, so rebuild (npm run build) after changing them.

# ---- Real sign-in (Supabase). Leave both empty for the labelled offline demo mode.
# Supabase dashboard > Project Settings > API. The anon / publishable key is public by
# design and only works together with row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL used in email links. Must match a Redirect URL allowed in Supabase
# (Authentication > URL Configuration), e.g. http://localhost:3000/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the Next.js server forwards /proxy/api/* (server-side only, not sent to browsers).
BACKEND_URL=http://127.0.0.1:8000
# Optional. Session cookies are Secure in production builds; browsers accept that on
# http://localhost. Set COOKIE_SECURE=false only if you must serve over plain http elsewhere.
# COOKIE_SECURE=

# ---- Demo mode only (used when the Supabase values above are empty)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEMO_BUSINESS_ID=11111111-1111-1111-1111-111111111111

# NEVER put SUPABASE_SERVICE_KEY / service-role or secret keys here. They belong to the
# backend only (backend/.env).
