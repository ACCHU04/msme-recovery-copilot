# Backend (copy to backend/.env, never commit the real file)
STORE=memory                      # memory = offline demo data; supabase = real database
AUTH_MODE=demo                    # demo (memory store only) or supabase; STORE=supabase forces supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=             # service-role key: server only, never in the frontend
SUPABASE_JWT_SECRET=              # only for legacy HS256 projects; leave empty to use the project's JWKS keys
CORS_ORIGINS=http://localhost:3000,https://YOUR-APP.vercel.app
DEMO_BUSINESS_ID=11111111-1111-1111-1111-111111111111

# AI legal assistant (optional). Server only; without it the app uses prepared answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Added later by P3
WA_TOKEN=
WA_VERIFY_TOKEN=
WA_PHONE_ID=
WA_APP_SECRET=

# Optional: the GST Invoice Registration Portal's public key (PEM, one line with \n) to verify
# the signature of e-invoice QR codes. Without it, QR details are read but marked "not verified".
EINVOICE_PUBLIC_KEY=

# Optional: email reminders through Resend (resend.com). Leave both empty to keep reminders
# in-app only; the "Email me these" button appears only when both are set.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
